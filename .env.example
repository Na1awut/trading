# ---------------------------------------------------------------------------
# Stock Signal Alerts - environment configuration
# Copy to .env (git-ignored) and adjust. NEVER commit real secrets.
# All values below work for local development with no paid services.
# ---------------------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=info

# --- Database (docker compose up -d postgres) -------------------------------
DATABASE_URL=postgresql://signals:signals@localhost:5432/signals?schema=public
# Used by API/worker integration tests (created by docker/postgres-init.sql)
TEST_DATABASE_URL=postgresql://signals:signals@localhost:5432/signals_test?schema=public

# --- API --------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=4000
# Comma-separated origins. "*" is rejected when NODE_ENV=production.
CORS_ORIGINS=*
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
ENABLE_SWAGGER=true

# --- Authentication -----------------------------------------------------------
# dev      -> accepts "Authorization: Bearer dev:<email>" (LOCAL ONLY; refused in production)
# firebase -> verifies Firebase ID tokens with the Admin SDK
AUTH_MODE=dev
# Reject Firebase password accounts whose email is not verified (403).
AUTH_REQUIRE_EMAIL_VERIFIED=false
# Also reject revoked sessions (one extra Firebase call per request).
AUTH_CHECK_REVOKED=false

# --- Firebase (required for AUTH_MODE=firebase or NOTIFICATION_DRIVER=fcm) ---------
# Create a service account in Firebase Console > Project settings > Service accounts.
# Provide it via ONE of: a file path outside the repo, a base64 secret, or
# GOOGLE_APPLICATION_CREDENTIALS (Application Default Credentials).
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_SERVICE_ACCOUNT_BASE64=

# --- Push notifications -------------------------------------------------------
# console -> logs notifications to the worker console (dev)
# fcm     -> Firebase Cloud Messaging
NOTIFICATION_DRIVER=console
# Delivery state machine: attempts per event, exponential back-off (base doubles, capped),
# how long a SENDING claim may last before it is considered crashed, and the age after
# which an undelivered alert is abandoned instead of being sent late.
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_RETRY_BASE_MS=30000
NOTIFICATION_RETRY_MAX_MS=1800000
NOTIFICATION_SENDING_TIMEOUT_MS=120000
NOTIFICATION_MAX_AGE_MS=86400000
NOTIFICATION_SWEEP_BATCH=100
# Devices kept per user (least recently seen are pruned).
MAX_DEVICES_PER_USER=10

# --- Market data ----------------------------------------------------------------
# mock -> deterministic synthetic data, no API key needed (refused in production unless
#         ALLOW_MOCK_MARKET_DATA=true, e.g. for staging)
# real -> RealMarketDataProvider with MARKET_DATA_VENDOR (supported: twelvedata)
MARKET_DATA_PROVIDER=mock
ALLOW_MOCK_MARKET_DATA=false
MARKET_DATA_VENDOR=
# Secret. Sent to the vendor only; redacted from logs and errors.
MARKET_DATA_API_KEY=
# Optional override; must be https and on the vendor's host allowlist (SSRF guard)
# unless MARKET_DATA_ALLOW_CUSTOM_BASE_URL=true (e.g. an egress proxy).
MARKET_DATA_BASE_URL=
MARKET_DATA_ALLOW_CUSTOM_BASE_URL=false
# Set to match your plan; the app shows "Delayed" next to prices when true.
MARKET_DATA_DELAYED=true
MARKET_DATA_TIMEOUT_MS=8000
MARKET_DATA_MAX_RETRIES=3
# Client-side budget per process (Twelve Data Basic: 8/min). API and worker each have one.
MARKET_DATA_RATE_LIMIT_PER_MINUTE=8
MARKET_DATA_QUOTE_TTL_MS=10000
# A quote older than this while the market is open is flagged stale in the app.
MARKET_DATA_STALE_QUOTE_MS=1800000

# --- Signal worker ----------------------------------------------------------------
# How often the worker runs an evaluation cycle.
SIGNAL_POLL_INTERVAL_MS=15000
# Timeframe used for preset signals created when a ticker is added to a watchlist.
# 1m makes mock-data crossovers visible within minutes during development.
SIGNAL_DEFAULT_TIMEFRAME=1m
# Candles fetched per (symbol, timeframe) per cycle (>= 200 keeps EMA 50 / MACD warm).
SIGNAL_CANDLE_LOOKBACK=250
SIGNAL_FETCH_CONCURRENCY=4
# A candle counts as closed only this long after its interval ends (vendor publish lag).
CANDLE_CLOSE_GRACE_MS=5000
# Missed closed candles evaluated in order after a delay; older gaps are skipped.
SIGNAL_MAX_CATCHUP_CANDLES=3
# Back-off base when the vendor has not yet published the expected closed candle.
SIGNAL_INCOMPLETE_REFETCH_MS=60000
# Horizontal scaling without a queue: run N workers with index 0..N-1.
WORKER_SHARD_INDEX=0
WORKER_SHARD_COUNT=1
