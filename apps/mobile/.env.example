# Copy to apps/mobile/.env (git-ignored). EXPO_PUBLIC_* values are embedded in the app bundle -
# never put secrets here (Firebase web config is not secret; service accounts are).

# API base URL. Android emulator: http://10.0.2.2:4000 ; physical device: http://<your-LAN-IP>:4000
EXPO_PUBLIC_API_URL=http://localhost:4000

# Firebase web config (Firebase console > Project settings > Your apps). Leave empty to use
# dev login (requires the API to run with AUTH_MODE=dev).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google sign-in (optional; requires Firebase above). OAuth client IDs from Google Cloud
# console > Credentials (the Firebase Google provider shows the web client ID).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
